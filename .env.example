# Supabase Public API Configuration (Safe for client-side execution via Vite)
# Connect to your Supabase project (Settings -> API)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Server-Only Secret (NEVER prefix with VITE_ or expose to client bundles!)
# Required only for administrative scripts, backend seed sync, and testing runners.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Optional Gemini AI API Key (Injected automatically in AI Studio Cloud Run)
GEMINI_API_KEY=""

# Application Host URL
